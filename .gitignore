# Virtual environment
venv/

# Python cache
__pycache__/
*.pyc

# Environment secrets
.env

# OS junk
.DS_Store

# Model artifacts — ignored by default (can be large),
# but explicitly allow the small, versioned Analytics models
*.joblib
*.pt
*.pth
!models/analytics/*.joblib

# IDE
.vscode/

# Vision model — tracked via Git LFS, allow despite *.pt / *.pth ignore above
!models/vision/*.pt

# Raw collected real images — large, and some may be copyrighted;
# keep only the processing scripts, not the images themselves
data/real_images/
data/real_images_split/
data/images/
data/images_split/

# Language module — intent classifier tracked via Git LFS
!models/language/intent_classifier/**

# Training checkpoints — intermediate artifacts, not needed after training completes
models/language/intent_checkpoints/

# MLflow local tracking (SQLite backend + run artifacts)
mlflow.db
mlruns/

# Ad-hoc real-image test folder from Week 3 (not part of the versioned dataset)
data/real_test_images/

# Allow the small vector index despite general model-ignore patterns above
!models/language/vector_index/*

# Personal voice recordings and generated audio — not part of the versioned dataset
data/audio/

# OCR debug/test images from Week 6 (personal test data)
data/ocr_test/

# Runtime storage — uploaded files and generated audio, created by the running app
storage/
