# Virtual environment
venv/

# Python cache
__pycache__/
*.pyc

# Environment secrets
.env

# OS junk
.DS_Store

# Model artifacts — ignored by default (can be large),
# but explicitly allow the small, versioned Analytics models
*.joblib
*.pt
*.pth
!models/analytics/*.joblib

# IDE
.vscode/

# Vision model — tracked via Git LFS, allow despite *.pt / *.pth ignore above
!models/vision/*.pt

# Raw collected real images — large, and some may be copyrighted;
# keep only the processing scripts, not the images themselves
data/real_images/
data/real_images_split/
data/images/
data/images_split/

# Language module — intent classifier tracked via Git LFS
!models/language/intent_classifier/**

# Training checkpoints — intermediate artifacts, not needed after training completes
models/language/intent_checkpoints/
